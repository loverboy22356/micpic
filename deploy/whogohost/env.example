# Copy to /home/mispec/app/.env on the server and fill in real values.
# Never commit the real .env. python-decouple reads this file automatically
# (it is found next to manage.py), so no systemd EnvironmentFile is needed.

# ---- Django ----
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.mispec.co.uk,www.api.mispec.co.uk
# Comma separated, must include the scheme (used by the admin login form)
CSRF_TRUSTED_ORIGINS=https://api.mispec.co.uk

# ---- Database (PostgreSQL on the same VPS) ----
# postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME
DATABASE_URL=postgres://mispec:CHANGE_ME@127.0.0.1:5432/mispec

# ---- Redis (Celery broker + result backend, same VPS) ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Email / notifications ----
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=info@mispec.co.uk
BREVO_API_KEY=
BIRD_EMAIL_API_KEY=
MAILBIT_API_KEY=

# ---- Calls (Agora / Dyte / Pusher) ----
AGORA_APP_ID=
AGORA_APP_CERT=
# Pusher keys are read with these exact lowercase names by mispec/settings.py
app_id=
key=
secret=
cluster=us2
DYTE_API_BASE_URL=https://api.dyte.io
DYTE_ORG_ID=
DYTE_API_KEY=

# ---- Cloudinary (default file storage for uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Push notifications / store receipts ----
# Path to the Firebase service account JSON, relative to the backend folder
# or absolute. Upload the file to the server, never commit it.
GOOGLE_SERVICE_ACCOUNT_FILE=firebase/mispec-firebase-adminsdk.json
APPLE_SHARED_SECRET=

# ---- Optional Gunicorn tuning ----
# GUNICORN_WORKERS=3
# GUNICORN_BIND=127.0.0.1:8000
